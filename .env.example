# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
# NEVER commit .env.local. Do not put production keys or service-account JSON in this repo.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# App Check (required by Firebase AI Logic)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key
# Set to true on the judging build so the App Check debug provider is used.
VITE_APPCHECK_DEBUG=false
# Optional: a debug token registered in Firebase console > App Check > Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
